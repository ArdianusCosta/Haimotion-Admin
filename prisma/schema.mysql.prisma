  status      String   @default("Pending") @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  employee    User     @relation("HrUserLeaves", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_leave_requests_employee_id_fkey")
  @@map("hr_leave_requests")
}

model HrPayroll {
  id           Int      @id @default(autoincrement())
  employee_id  Int
  period       String   @db.VarChar(50)
  basic_salary Float
  allowance    Float    @default(0)
  deduction    Float    @default(0)
  net_pay      Float
  status       String   @default("Pending") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  employee     User     @relation("HrUserPayrolls", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_payrolls_employee_id_fkey")
  @@map("hr_payrolls")
}

model HrCandidate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  email        String   @unique @db.VarChar(200)
  role_applied String   @db.VarChar(100)
  applied_date DateTime @db.Date
  rating       Int      @default(0)
  status       String   @default("Applied") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@map("hr_candidates")
}

model Meeting {
  id           Int                  @id @default(autoincrement())
  title        String               @db.VarChar(255)
  description  String?              @db.Text
  organizer_id Int
  date         DateTime             @db.Date
  start_time   DateTime             @db.Time(0)
  duration     Int
  status       String               @default("SCHEDULED") @db.VarChar(50)
  room_name    String?              @unique @default(uuid()) @db.VarChar(255)
  meeting_code String?              @unique @db.VarChar(20)
  join_policy  String               @default("PUBLIC_LINK") @db.VarChar(50)
  waiting_room Boolean              @default(false)
  passcode     String?              @db.VarChar(50)
  project_id   Int?
  task_id      Int?
  created_at   DateTime             @default(now())
  updated_at   DateTime             @default(now()) @updatedAt
  participants MeetingParticipant[]
  organizer    User                 @relation("MeetingOrganizer", fields: [organizer_id], references: [id])
  project      project_list?        @relation(fields: [project_id], references: [id])
  task         task_list?           @relation(fields: [task_id], references: [id])

  @@index([meeting_code], map: "meetings_meeting_code_idx")
  @@index([organizer_id], map: "meetings_organizer_id_fkey")
  @@index([project_id], map: "meetings_project_id_fkey")
  @@index([task_id], map: "meetings_task_id_fkey")
  @@map("meetings")
}

model MeetingParticipant {
  id          Int       @id @default(autoincrement())
  meeting_id  Int
  user_id     Int?
  guest_name  String?   @db.VarChar(255)
  guest_email String?   @db.VarChar(255)
  role        String    @default("PARTICIPANT") @db.VarChar(50)
  status      String    @default("JOINED") @db.VarChar(50)
  joined_at   DateTime?
  left_at     DateTime?
  created_at  DateTime  @default(now())
  meeting     Meeting   @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([meeting_id, user_id])
  @@index([meeting_id], map: "meeting_participants_meeting_id_fkey")
  @@index([user_id], map: "meeting_participants_user_id_fkey")
  @@map("meeting_participants")
}

model FinanceProductService {
  id         Int      @id @default(autoincrement())
  code       String   @unique @db.VarChar(100)
  name       String   @db.VarChar(255)
  type       String   @db.VarChar(50)
  unit       String   @db.VarChar(50)
  brand      String?  @db.VarChar(100)
  price      Float    @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("finance_products_services")
}

model FinanceContact {
  id         Int      @id @default(autoincrement())
  type       String   @db.VarChar(50)
  name       String   @db.VarChar(255)
  email      String?  @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  address    String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("finance_contacts")
}

model CrmClient {
  id              Int       @id @default(autoincrement())
  company_name    String    @db.VarChar(255)
  industry        String?   @db.VarChar(100)
  website         String?   @db.VarChar(255)
  address         String?   @db.Text
  city            String?   @db.VarChar(100)
  province        String?   @db.VarChar(100)
  country         String?   @db.VarChar(100)
  status          String    @default("Active") @db.VarChar(50)
  source          String?   @db.VarChar(100)
  customer_since  DateTime? @db.Date
  last_contact_at DateTime? @db.DateTime(0)
  next_follow_up  DateTime? @db.DateTime(0)

  assigned_user_id Int?
  assigned_user    User? @relation("AssignedClients", fields: [assigned_user_id], references: [id])

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  contacts   CrmContact[]
  projects   project_list[]
  deals      CrmDeal[]
  activities CrmActivity[]
  follow_ups CrmFollowUp[]
  notes      CrmNote[]
  tags       CrmClientTag[]

  @@index([assigned_user_id])
  @@map("crm_clients")
}

model CrmContact {
  id        Int       @id @default(autoincrement())
  client_id Int
  client    CrmClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  name       String  @db.VarChar(255)
  position   String? @db.VarChar(100)
  email      String? @db.VarChar(255)
  phone      String? @db.VarChar(50)
  whatsapp   String? @db.VarChar(50)
  is_primary Boolean @default(false)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@index([client_id])
  @@map("crm_contacts")
}

model CrmLead {
  id              Int     @id @default(autoincrement())
  name            String  @db.VarChar(255)
  company         String? @db.VarChar(255)
  email           String? @db.VarChar(255)
  phone           String? @db.VarChar(50)
  whatsapp        String? @db.VarChar(50)
  source          String? @db.VarChar(100)
  industry        String? @db.VarChar(100)
  status          String  @default("New") @db.VarChar(50)
  pipeline_stage  String? @db.VarChar(100)
  estimated_value Float?  @db.Float

  assigned_user_id Int?
  assigned_user    User? @relation("AssignedLeads", fields: [assigned_user_id], references: [id])

  next_follow_up DateTime? @db.DateTime(0)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  deals      CrmDeal[]
  activities CrmActivity[]
  follow_ups CrmFollowUp[]
  notes      CrmNote[]
  tags       CrmLeadTag[]

  @@index([assigned_user_id])
  @@map("crm_leads")
}

model CrmDeal {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(255)

  client_id Int?
  client    CrmClient? @relation(fields: [client_id], references: [id])

  lead_id Int?
  lead    CrmLead? @relation(fields: [lead_id], references: [id])

  assigned_user_id Int?
  assigned_user    User? @relation("AssignedDeals", fields: [assigned_user_id], references: [id])

  stage          String    @db.VarChar(100)
  value          Float?    @db.Float
  probability    Int?      @default(0)
  expected_close DateTime? @db.Date

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  activities     CrmActivity[]
  follow_ups     CrmFollowUp[]
  pipeline_id    Int?
  pipeline       CrmPipeline?      @relation(fields: [pipeline_id], references: [id])
  stage_id       Int?
  pipeline_stage CrmPipelineStage? @relation(fields: [stage_id], references: [id])

  @@index([client_id])
  @@index([lead_id])
  @@index([assigned_user_id])
  @@map("crm_deals")
}

model CrmActivity {
  id      Int  @id @default(autoincrement())
  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  client_id Int?
  client    CrmClient? @relation(fields: [client_id], references: [id])

  lead_id Int?
  lead    CrmLead? @relation(fields: [lead_id], references: [id])

  deal_id Int?
  deal    CrmDeal? @relation(fields: [deal_id], references: [id])

  type        String @db.VarChar(50)
  description String @db.Text

  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([user_id])
  @@index([client_id])
  @@index([lead_id])
  @@index([deal_id])
  @@map("crm_activities")
}

model CrmFollowUp {
  id Int @id @default(autoincrement())

  client_id Int?
  client    CrmClient? @relation(fields: [client_id], references: [id])

  lead_id Int?
  lead    CrmLead? @relation(fields: [lead_id], references: [id])

  deal_id Int?
  deal    CrmDeal? @relation(fields: [deal_id], references: [id])

  assigned_user_id Int?
  assigned_user    User? @relation("AssignedFollowUps", fields: [assigned_user_id], references: [id])

  type     String   @db.VarChar(50)
  status   String   @default("Pending") @db.VarChar(50)
  due_date DateTime @db.DateTime(0)
  notes    String?  @db.Text

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@index([client_id])
  @@index([lead_id])
  @@index([deal_id])
  @@index([assigned_user_id])
  @@map("crm_follow_ups")
}

model CrmNote {
  id      Int    @id @default(autoincrement())
  content String @db.Text

  author_id Int
  author    User @relation(fields: [author_id], references: [id])

  client_id Int?
  client    CrmClient? @relation(fields: [client_id], references: [id])

  lead_id Int?
  lead    CrmLead? @relation(fields: [lead_id], references: [id])

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@index([author_id])
  @@index([client_id])
  @@index([lead_id])
  @@map("crm_notes")
}

model CrmTag {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  color String? @db.VarChar(20)

  clients CrmClientTag[]
  leads   CrmLeadTag[]

  @@map("crm_tags")
}

model CrmClientTag {
  client_id Int
  tag_id    Int

  client CrmClient @relation(fields: [client_id], references: [id], onDelete: Cascade)
  tag    CrmTag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([client_id, tag_id])
  @@index([client_id])
  @@index([tag_id])
  @@map("crm_client_tags")
}

model CrmLeadTag {
  lead_id Int
  tag_id  Int

  lead CrmLead @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  tag  CrmTag  @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([lead_id, tag_id])
  @@index([lead_id])
  @@index([tag_id])
  @@map("crm_lead_tags")
}

model CrmBroadcastCampaign {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  audience_type String    @db.VarChar(100)
  channel       String    @default("WhatsApp") @db.VarChar(50)
  message       String    @db.Text
  status        String    @default("Draft") @db.VarChar(50)
  scheduled_at  DateTime? @db.DateTime(0)

  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  recipients CrmBroadcastRecipient[]

  @@map("crm_broadcast_campaigns")
}

model CrmBroadcastRecipient {
  id          Int                  @id @default(autoincrement())
  campaign_id Int
  campaign    CrmBroadcastCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  client_id Int?
  lead_id   Int?

  contact_info String  @db.VarChar(255)
  status       String  @default("Pending") @db.VarChar(50)
  error_msg    String? @db.Text

  sent_at DateTime? @db.DateTime(0)

  @@index([campaign_id])
  @@map("crm_broadcast_recipients")
}

