  department               String?  @db.VarChar(100)
  work_hours_standard      Float?
  work_hours_actual        Float?
  late_hours               Int?
  late_minutes             Int?
  early_leave_hours        Int?
  early_leave_minutes      Int?
  overtime_normal          Float?
  overtime_special         Float?
  attendance_days_standard Float?
  attendance_days_actual   Float?
  business_trip_days       Int?
  absent_days              Int?
  leave_days               Int?
  percentage               Float?
