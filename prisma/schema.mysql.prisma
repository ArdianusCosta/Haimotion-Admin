model ProjectMilestone {
  id          Int          @id @default(autoincrement())
  project_id  Int
  project     project_list @relation(fields: [project_id], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(255)
  description String?      @db.Text
  due_date    DateTime?    @db.Date
  status      String       @default("Pending") @db.VarChar(50)
  created_at  DateTime     @default(now()) @db.DateTime(0)
  updated_at  DateTime     @default(now()) @updatedAt @db.DateTime(0)
  tasks       task_list[]

  @@index([project_id])
  @@map("project_milestones")
}

model TaskChecklist {
  id         Int       @id @default(autoincrement())
  task_id    Int
  task       task_list @relation(fields: [task_id], references: [id], onDelete: Cascade)
  label      String    @db.VarChar(255)
  is_done    Boolean   @default(false)
  order      Int       @default(0)
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @updatedAt @db.DateTime(0)

  @@index([task_id])
  @@map("task_checklists")
}

model TaskDependency {
  id              Int       @id @default(autoincrement())
  task_id         Int
  task            task_list @relation("TaskDependencies", fields: [task_id], references: [id], onDelete: Cascade)
  depends_on_id   Int
  depends_on_task task_list @relation("TaskDependedBy", fields: [depends_on_id], references: [id], onDelete: Cascade)
  created_at      DateTime  @default(now()) @db.DateTime(0)

  @@unique([task_id, depends_on_id])
  @@index([depends_on_id])
  @@map("task_dependencies")
}

model CrmPipeline {
  id         Int                @id @default(autoincrement())
  name       String             @db.VarChar(255)
  is_active  Boolean            @default(true)
  created_at DateTime           @default(now()) @db.DateTime(0)
  updated_at DateTime           @default(now()) @updatedAt @db.DateTime(0)
  stages     CrmPipelineStage[]
  deals      CrmDeal[]

  @@map("crm_pipelines")
}

model CrmPipelineStage {
  id          Int         @id @default(autoincrement())
  pipeline_id Int
  pipeline    CrmPipeline @relation(fields: [pipeline_id], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(100)
  order       Int         @default(0)
  probability Int         @default(0)
  created_at  DateTime    @default(now()) @db.DateTime(0)
  updated_at  DateTime    @default(now()) @updatedAt @db.DateTime(0)
  deals       CrmDeal[]

  @@index([pipeline_id])
  @@map("crm_pipeline_stages")
}

model FinanceCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)
  description String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  expenses FinanceExpense[]
  budgets  FinanceBudget[]

  @@map("finance_categories")
}

model FinancePayment {
  id             Int            @id @default(autoincrement())
  invoice_id     Int
  invoice        FinanceInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  amount         Float
  payment_date   DateTime       @db.Date
  payment_method String         @db.VarChar(100)
  reference      String?        @db.VarChar(255)
  notes          String?        @db.Text
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt

  @@index([invoice_id])
  @@map("finance_payments")
}

model FinanceBudget {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(255)
  amount      Float
  period      String?          @db.VarChar(50)
  spent       Float            @default(0)
  start_date  DateTime         @db.Date
  end_date    DateTime         @db.Date
  category_id Int?
  category    FinanceCategory? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  project_id  Int?
  project     project_list?    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @default(now()) @updatedAt

  @@index([category_id])
  @@index([project_id])
  @@map("finance_budgets")
}

model HrDepartment {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(255)
  description String?      @db.Text
  manager_id  Int?
  manager     User?        @relation("DepartmentManager", fields: [manager_id], references: [id])
  created_at  DateTime     @default(now())
  updated_at  DateTime     @default(now()) @updatedAt
  employees   HrEmployee[]
  HrPosition  HrPosition[]

  @@index([manager_id])
  @@map("hr_departments")
}

model HrPosition {
  id            Int           @id @default(autoincrement())
  title         String        @db.VarChar(255)
  department_id Int?
  department    HrDepartment? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now()) @updatedAt
  employees     HrEmployee[]

  @@index([department_id])
  @@map("hr_positions")
}

model HrWorkSchedule {
  id          Int        @id @default(autoincrement())
  employee_id Int
  employee    HrEmployee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  day_of_week Int
  start_time  String     @db.VarChar(10)
  end_time    String     @db.VarChar(10)
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now()) @updatedAt

  @@index([employee_id])
  @@map("hr_work_schedules")
}

model HrOvertime {
  id          Int        @id @default(autoincrement())
  employee_id Int
  employee    HrEmployee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  hours       Float
  reason      String     @db.Text
  status      String     @default("Pending") @db.VarChar(50)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @default(now()) @updatedAt

  @@index([employee_id])
  @@map("hr_overtimes")
}

model CalendarEvent {
  id           Int                   @id @default(autoincrement())
  title        String                @db.VarChar(255)
  description  String?               @db.Text
  start_date   DateTime              @db.DateTime(0)
  end_date     DateTime              @db.DateTime(0)
  is_all_day   Boolean               @default(false)
  location     String?               @db.VarChar(255)
  event_type   String                @default("General") @db.VarChar(50)
  color        String?               @db.VarChar(50)
  organizer_id Int?
  organizer    User?                 @relation(fields: [organizer_id], references: [id])
  created_at   DateTime              @default(now())
  updated_at   DateTime              @default(now()) @updatedAt
  participants CalendarParticipant[]
  reminders    CalendarReminder[]

  @@index([organizer_id])
  @@map("calendar_events")
}

model CalendarParticipant {
  id         Int           @id @default(autoincrement())
  event_id   Int
  event      CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id    Int
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status     String        @default("Pending") @db.VarChar(50)
  created_at DateTime      @default(now())

  @@unique([event_id, user_id])
  @@index([user_id])
  @@map("calendar_participants")
}

model CalendarReminder {
  id             Int           @id @default(autoincrement())
  event_id       Int
  event          CalendarEvent @relation(fields: [event_id], references: [id], onDelete: Cascade)
  minutes_before Int
  method         String        @default("Notification") @db.VarChar(50)
  created_at     DateTime      @default(now())

  @@index([event_id])
  @@map("calendar_reminders")
}
