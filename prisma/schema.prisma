generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                      @id @default(autoincrement())
  firstname               String                   @db.VarChar(200)
  lastname                String                   @db.VarChar(200)
  email                   String                   @unique @db.VarChar(200)
  notification_email      String?                  @db.VarChar(255)
  password                String                   @db.Text
  avatar                  String                   @db.Text
  date_created            DateTime                 @default(now()) @db.DateTime(0)
  nik                     String?                  @db.VarChar(50)
  address                 String?                  @db.Text
  emailVerified           Boolean                  @default(false)
  status                  String                   @default("active") @db.VarChar(50)
  role_id                 Int?
  updatedAt               DateTime                 @default(now()) @updatedAt
  name                    String?                  @db.VarChar(400)
  face_descriptor         String?                  @db.Text
  files                   File[]
  files_shared_by_me      FileShare[]              @relation("SharedByUserFiles")
  files_shared_with_me    FileShare[]              @relation("SharedWithUserFiles")
  folders                 Folder[]
  folders_shared_by_me    FolderShare[]            @relation("SharedByUserFolders")
  folders_shared_with_me  FolderShare[]            @relation("SharedWithUserFolders")
  user_preference         UserPreference?
  accounts                Account[]
  ai_chat_history         ai_chat_history[]
  ai_chat_thread          ai_chat_thread[]
  chat_groups             ChatGroup[]
  chat_messages           ChatMessage[]
  threads_as_user1        ChatThread[]             @relation("User1Threads")
  threads_as_user2        ChatThread[]             @relation("User2Threads")
  group_members           group_members[]
  group_messages          GroupMessage[]
  hr_attendance_summaries HrAttendanceSummary[]    @relation("HrUserAttendanceSummary")
  hr_attendances          HrAttendance[]           @relation("HrUserAttendance")
  hr_leaves               HrLeaveRequest[]         @relation("HrUserLeaves")
  hr_payrolls             HrPayroll[]              @relation("HrUserPayrolls")
  meeting_participations  MeetingParticipant[]
  organized_meetings      Meeting[]                @relation("MeetingOrganizer")
  passkeys                Passkey[]
  project_members         ProjectMember[]
  sessions                Session[]
  task_assignees          TaskAssignee[]
  user_group_read_status  user_group_read_status[]
  role                    Role?                    @relation(fields: [role_id], references: [id])

  @@index([role_id], map: "users_role_id_fkey")
  @@map("users")
}

model ChatGroup {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(255)
  description            String?                  @db.Text
  created_by             Int?
  date_created           DateTime?                @default(now()) @db.DateTime(0)
  last_message_at        DateTime?                @default(now()) @db.DateTime(0)
  users                  User?                    @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "chat_groups_ibfk_1")
  group_members          group_members[]
  messages               GroupMessage[]
  user_group_read_status user_group_read_status[]

  @@index([created_by], map: "created_by")
  @@map("chat_groups")
}

model GroupMessage {
  id              Int       @id @default(autoincrement())
  group_id        Int
  sender_id       Int
  message_content String    @db.Text
  attachment      String?   @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  group           ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_messages_ibfk_1")
  sender          User      @relation(fields: [sender_id], references: [id], onUpdate: Restrict, map: "group_messages_ibfk_2")

  @@index([group_id], map: "group_id")
  @@index([sender_id], map: "sender_id")
  @@map("group_messages")
}

model ChatThread {
  id              Int           @id @default(autoincrement())
  user1_id        Int
  user2_id        Int
  last_message_at DateTime      @default(now()) @db.DateTime(0)
  calls           Call[]
  messages        ChatMessage[]
  user1           User          @relation("User1Threads", fields: [user1_id], references: [id], onUpdate: Restrict, map: "chat_threads_ibfk_1")
  user2           User          @relation("User2Threads", fields: [user2_id], references: [id], onUpdate: Restrict, map: "chat_threads_ibfk_2")

  @@unique([user1_id, user2_id], map: "unique_thread_pair")
  @@index([user2_id], map: "user2_id")
  @@map("chat_threads")
}

model ChatMessage {
  id              Int           @id @default(autoincrement())
  thread_id       Int
  sender_id       Int
  message_content String        @db.Text
  attachment      String?       @db.VarChar(255)
  created_at      DateTime      @default(now()) @db.DateTime(0)
  is_read         Boolean       @default(false)
  reply_to_id     Int?
  thread          ChatThread    @relation(fields: [thread_id], references: [id], onUpdate: Restrict, map: "chat_messages_ibfk_1")
  sender          User          @relation(fields: [sender_id], references: [id], onUpdate: Restrict, map: "chat_messages_ibfk_2")
  reply_to        ChatMessage?  @relation("MessageReplies", fields: [reply_to_id], references: [id])
  replies         ChatMessage[] @relation("MessageReplies")

  @@index([sender_id], map: "sender_id")
  @@index([thread_id], map: "thread_id")
  @@index([reply_to_id], map: "reply_to_id")
  @@map("chat_messages")
}

model Call {
  id         Int        @id @default(autoincrement())
  thread_id  Int
  caller_id  Int
  room_name  String     @unique(map: "unique_room") @db.VarChar(255)
  type       String     @db.VarChar(50)
  status     String     @db.VarChar(50)
  started_at DateTime?  @db.DateTime(0)
  ended_at   DateTime?  @db.DateTime(0)
  duration   Int?
  created_at DateTime   @default(now()) @db.DateTime(0)
  thread     ChatThread @relation(fields: [thread_id], references: [id], onUpdate: Restrict, map: "calls_ibfk_1")

  @@index([thread_id], map: "thread_id")
  @@map("calls")
}

model activity_log {
  id            Int       @id @default(autoincrement())
  user_id       Int
  project_id    Int?
  task_id       Int?
  activity_type String    @db.VarChar(50)
  description   String    @db.Text
  ip_address    String?   @db.VarChar(100)
  user_agent    String?   @db.Text
  created_at    DateTime? @default(now()) @db.DateTime(0)
}

model events {
  id                   Int       @id @default(autoincrement())
  ical_uid             String?   @db.VarChar(255)
  google_calendar_id   String?   @db.VarChar(255)
  project_id           Int?
  title                String    @db.VarChar(255)
  start_event          DateTime  @db.DateTime(0)
  end_event            DateTime  @db.DateTime(0)
  color                String?   @default("bg-primary") @db.VarChar(50)
  description          String?   @db.Text
  notification_sent    Boolean?  @default(false)
  notification_sent_at DateTime? @db.DateTime(0)

  @@index([id], map: "id")
  @@index([google_calendar_id], map: "idx_google_calendar_id")
  @@index([ical_uid], map: "idx_ical_uid")
  @@index([project_id], map: "idx_project")
}

model group_members {
  id          Int       @id @default(autoincrement())
  group_id    Int
  user_id     Int
  is_admin    Boolean?  @default(false)
  date_joined DateTime? @default(now()) @db.DateTime(0)
  chat_groups ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_members_ibfk_1")
  users       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_members_ibfk_2")

  @@unique([group_id, user_id], map: "unique_member")
  @@index([user_id], map: "user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model notification_list {
  id           Int      @id @default(autoincrement())
  user_id      Int
  type         Boolean
  message      String   @db.Text
  link         String   @db.Text
  is_read      Boolean  @default(false)
  date_created DateTime @default(now()) @db.DateTime(0)
  task_id      String?  @db.VarChar(255)
}

model project_list {
  id           Int                @id @default(autoincrement())
  name         String             @db.VarChar(200)
  description  String             @db.Text
  status       Int                @db.TinyInt
  start_date   DateTime           @db.Date
  end_date     DateTime           @db.Date
  manager_id   Int
  date_created DateTime           @default(now()) @db.DateTime(0)
  client_name  String?            @db.VarChar(200)
  is_archived  Boolean            @default(false)
  is_favorite  Boolean            @default(false)
  meetings     Meeting[]
  members      ProjectMember[]
}

model system_settings {
  id        Int    @id @default(autoincrement())
  name      String @db.Text
  email     String @db.VarChar(200)
  contact   String @db.VarChar(20)
  address   String @db.Text
  cover_img String @db.Text
}

model task_list {
  id              Int            @id @default(autoincrement())
  project_id      Int
  user_id         Int?
  task            String         @db.VarChar(200)
  description     String         @db.Text
  status          Int            @db.TinyInt
  start_date      DateTime?      @db.Date
  end_date        DateTime?      @db.Date
  date_created    DateTime       @default(now()) @db.DateTime(0)
  created_by      Int?
  content_pillar  String?        @db.Text
  platform        String?        @db.Text
  reference_links String?        @db.Text
  date_updated    DateTime?      @db.DateTime(0)
  dependencies    String?        @db.Text
  meetings        Meeting[]
  assignees       TaskAssignee[]
}

model user_group_read_status {
  id           Int       @id @default(autoincrement())
  group_id     Int
  user_id      Int
  last_read_at DateTime  @default(now()) @db.DateTime(0)
  chat_groups  ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_group_read_status_ibfk_1")
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_group_read_status_ibfk_2")

  @@unique([group_id, user_id], map: "unique_read")
  @@index([user_id], map: "user_id")
}

model user_productivity {
  id            Int      @id @default(autoincrement())
  project_id    Int
  task_id       Int
  comment       String   @db.Text
  subject       String   @db.VarChar(200)
  date          DateTime @db.Date
  start_time    DateTime @db.Time(0)
  end_time      DateTime @db.Time(0)
  user_id       Int
  time_rendered Float    @db.Float
  date_created  DateTime @default(now()) @db.DateTime(0)
}

model task_comments {
  id         Int      @id @default(autoincrement())
  task_id    Int
  user_id    Int
  comment    String   @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  parent_id  Int?

  @@index([task_id], map: "idx_task_comments_task")
}

model task_attachments {
  id          Int      @id @default(autoincrement())
  task_id     Int
  file_url    String   @db.VarChar(500)
  file_name   String   @db.VarChar(255)
  uploaded_by Int?
  uploaded_at DateTime @default(now()) @db.DateTime(0)

  @@index([task_id], map: "idx_task_attachments_task")
}

model ai_chat_thread {
  id         String            @id @default(uuid())
  user_id    Int
  title      String            @db.VarChar(255)
  created_at DateTime          @default(now()) @db.DateTime(0)
  updated_at DateTime          @default(now()) @updatedAt @db.DateTime(0)
  is_pinned  Boolean           @default(false)
  messages   ai_chat_history[]
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_ai_thread")
}

model ai_chat_history {
  id         Int            @id @default(autoincrement())
  user_id    Int
  role       String         @db.VarChar(50)
  content    String         @db.Text
  created_at DateTime       @default(now()) @db.DateTime(0)
  thread_id  String
  thread     ai_chat_thread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  users      User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_ai_chat")
  @@index([thread_id], map: "idx_thread_ai_chat")
}

model Folder {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(255)
  parent_id  Int?
  owner_id   Int
  created_at DateTime      @default(now()) @db.DateTime(0)
  updated_at DateTime      @default(now()) @updatedAt @db.DateTime(0)
  deleted_at DateTime?     @db.DateTime(0)
  files      File[]
  owner      User          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  parent     Folder?       @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children   Folder[]      @relation("FolderHierarchy")
  shares     FolderShare[]

  @@index([owner_id], map: "idx_folder_owner")
  @@index([parent_id], map: "idx_folder_parent")
}

model File {
  id            Int         @id @default(autoincrement())
  name          String      @db.VarChar(255)
  original_name String      @db.VarChar(255)
  storage_key   String      @db.VarChar(500)
  mime_type     String      @db.VarChar(100)
  extension     String      @db.VarChar(50)
  size          BigInt
  folder_id     Int?
  owner_id      Int
  is_starred    Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  updated_at    DateTime    @default(now()) @updatedAt @db.DateTime(0)
  deleted_at    DateTime?   @db.DateTime(0)
  folder        Folder?     @relation(fields: [folder_id], references: [id])
  owner         User        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  shares        FileShare[]

  @@index([owner_id], map: "idx_file_owner")
  @@index([folder_id], map: "idx_file_folder")
}

model FileShare {
  id                  Int      @id @default(autoincrement())
  file_id             Int
  permission          String   @db.VarChar(50)
  created_at          DateTime @default(now()) @db.DateTime(0)
  shared_by_user_id   Int
  shared_with_user_id Int
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime(0)
  file                File     @relation(fields: [file_id], references: [id], onDelete: Cascade)
  shared_by_user      User     @relation("SharedByUserFiles", fields: [shared_by_user_id], references: [id], onDelete: Cascade)
  shared_with_user    User     @relation("SharedWithUserFiles", fields: [shared_with_user_id], references: [id], onDelete: Cascade)

  @@unique([file_id, shared_with_user_id], map: "uniq_fileshare")
  @@index([file_id], map: "idx_fileshare_file")
  @@index([shared_with_user_id], map: "idx_fileshare_shared_with")
  @@index([shared_by_user_id], map: "FileShare_shared_by_user_id_fkey")
}

model FolderShare {
  id                  Int      @id @default(autoincrement())
  folder_id           Int
  permission          String   @db.VarChar(50)
  created_at          DateTime @default(now()) @db.DateTime(0)
  shared_by_user_id   Int
  shared_with_user_id Int
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime(0)
  folder              Folder   @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  shared_by_user      User     @relation("SharedByUserFolders", fields: [shared_by_user_id], references: [id], onDelete: Cascade)
  shared_with_user    User     @relation("SharedWithUserFolders", fields: [shared_with_user_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, shared_with_user_id], map: "uniq_foldershare")
  @@index([folder_id], map: "idx_foldershare_folder")
  @@index([shared_with_user_id], map: "idx_foldershare_shared_with")
  @@index([shared_by_user_id], map: "FolderShare_shared_by_user_id_fkey")
}

model UserPreference {
  id                     Int      @id @default(autoincrement())
  user_id                Int      @unique
  file_manager_view_mode String   @default("grid") @db.VarChar(50)
  created_at             DateTime @default(now()) @db.DateTime(0)
  updated_at             DateTime @default(now()) @updatedAt @db.DateTime(0)
  content_width          String   @default("centered") @db.VarChar(50)
  header_style           String   @default("sticky") @db.VarChar(50)
  layout_style           String   @default("sidebar") @db.VarChar(50)
  sidebar_style          String   @default("sidebar") @db.VarChar(50)
  theme_color            String   @default("Green") @db.VarChar(50)
  theme_mode             String   @default("system") @db.VarChar(50)
  theme_radius           String   @default("0.5") @db.VarChar(10)
  font_family            String   @default("Inter") @db.VarChar(50)
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  id         Int    @id @default(autoincrement())
  role_id    Int
  permission String @db.VarChar(100)
  role       Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission])
  @@map("role_permissions")
}

model SystemPermission {
  id          String  @id @db.VarChar(100)
  category    String  @db.VarChar(100)
  name        String  @db.VarChar(100)
  description String? @db.Text

  @@map("system_permissions")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_fkey")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                Int
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_fkey")
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}




model ProjectMember {
  id         Int          @id @default(autoincrement())
  project_id Int
  user_id    Int
  created_at DateTime     @default(now()) @db.DateTime(0)
  project    project_list @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([project_id, user_id])
  @@index([user_id], map: "project_members_user_id_fkey")
  @@map("project_members")
}

model TaskAssignee {
  id         Int       @id @default(autoincrement())
  task_id    Int
  user_id    Int
  created_at DateTime  @default(now()) @db.DateTime(0)
  task       task_list @relation(fields: [task_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([task_id, user_id])
  @@index([user_id], map: "task_assignees_user_id_fkey")
  @@map("task_assignees")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String    @db.Text
  userId       Int
  credentialID String    @db.Text
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "passkeys_userId_fkey")
  @@map("passkeys")
}







model FinanceAccount {
  code           String?              @db.VarChar(50)
  sub_type       String?              @db.VarChar(100)
  id             Int                  @id @default(autoincrement())
  name           String               @db.VarChar(200)
  type           String               @db.VarChar(50)
  balance        Float                @default(0)
  currency       String               @default("USD") @db.VarChar(10)
  account_number String?              @db.VarChar(100)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt
  transactions   FinanceTransaction[]

  @@map("finance_accounts")
}

model FinanceInvoice {
  id             Int                  @id @default(autoincrement())
  reference      String               @unique @db.VarChar(100)
  customer_name  String               @db.VarChar(200)
  customer_email String?              @db.VarChar(200)
  date           DateTime             @db.Date
  due_date       DateTime             @db.Date
  amount         Float
  status         String               @default("Draft") @db.VarChar(50)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @default(now()) @updatedAt
  created_by     Int?
  items          FinanceInvoiceItem[]

  @@map("finance_invoices")
}

model FinanceInvoiceItem {
  id          Int            @id @default(autoincrement())
  invoice_id  Int
  description String         @db.Text
  quantity    Int            @default(1)
  price       Float
  invoice     FinanceInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id], map: "finance_invoice_items_invoice_id_fkey")
  @@map("finance_invoice_items")
}

model FinanceExpense {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  description String   @db.Text
  category    String   @db.VarChar(100)
  amount      Float
  vendor      String   @db.VarChar(200)
  status      String   @default("Pending") @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  created_by  Int?

  @@map("finance_expenses")
}

model FinanceTransaction {
  id          Int            @id @default(autoincrement())
  date        DateTime       @db.Date
  description String         @db.Text
  type        String         @db.VarChar(50)
  amount      Float
  account_id  Int
  reference   String?        @db.VarChar(200)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @default(now()) @updatedAt
  created_by  Int?
  account     FinanceAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([account_id], map: "finance_transactions_account_id_fkey")
  @@map("finance_transactions")
}

model HrEmployee {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(200)
  email      String   @unique @db.VarChar(200)
  role       String   @db.VarChar(100)
  department String   @db.VarChar(100)
  status     String   @default("Active") @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("hr_employees")
}

model HrAttendance {
  id          Int      @id @default(autoincrement())
  employee_id Int
  date        DateTime @db.Date
  time_in     String?  @db.VarChar(10)
  time_out    String?  @db.VarChar(10)
  status      String   @default("Present") @db.VarChar(50)
  notes       String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  employee    User     @relation("HrUserAttendance", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_attendances_employee_id_fkey")
  @@map("hr_attendances")
}

model HrAttendanceSummary {
  id                       Int      @id @default(autoincrement())
  employee_id              Int
  period                   String   @db.VarChar(50)
  department               String?  @db.VarChar(100)
  work_hours_standard      Float?
  work_hours_actual        Float?
  late_hours               Int?
  late_minutes             Int?
  early_leave_hours        Int?
  early_leave_minutes      Int?
  overtime_normal          Float?
  overtime_special         Float?
  attendance_days_standard Float?
  attendance_days_actual   Float?
  business_trip_days       Int?
  absent_days              Int?
  leave_days               Int?
  percentage               Float?
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now()) @updatedAt
  employee                 User     @relation("HrUserAttendanceSummary", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_attendance_summaries_employee_id_fkey")
  @@map("hr_attendance_summaries")
}

model HrLeaveRequest {
  id          Int      @id @default(autoincrement())
  employee_id Int
  type        String   @db.VarChar(100)
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  reason      String   @db.Text
  status      String   @default("Pending") @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  employee    User     @relation("HrUserLeaves", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_leave_requests_employee_id_fkey")
  @@map("hr_leave_requests")
}

model HrPayroll {
  id           Int      @id @default(autoincrement())
  employee_id  Int
  period       String   @db.VarChar(50)
  basic_salary Float
  allowance    Float    @default(0)
  deduction    Float    @default(0)
  net_pay      Float
  status       String   @default("Pending") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt
  employee     User     @relation("HrUserPayrolls", fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id], map: "hr_payrolls_employee_id_fkey")
  @@map("hr_payrolls")
}

model HrCandidate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  email        String   @unique @db.VarChar(200)
  role_applied String   @db.VarChar(100)
  applied_date DateTime @db.Date
  rating       Int      @default(0)
  status       String   @default("Applied") @db.VarChar(50)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@map("hr_candidates")
}

model Meeting {
  id              Int                  @id @default(autoincrement())
  title           String               @db.VarChar(255)
  description     String?              @db.Text
  organizer_id    Int
  date            DateTime             @db.Date
  start_time      DateTime             @db.Time(0)
  duration        Int
  status          String               @default("SCHEDULED") @db.VarChar(50)
  room_name       String?              @unique @default(uuid()) @db.VarChar(255)
  meeting_code    String?              @unique @db.VarChar(20)
  join_policy     String               @default("PUBLIC_LINK") @db.VarChar(50)
  waiting_room    Boolean              @default(false)
  passcode        String?              @db.VarChar(50)
  project_id      Int?
  task_id         Int?
  created_at      DateTime             @default(now())
  updated_at      DateTime             @default(now()) @updatedAt
  participants    MeetingParticipant[]
  organizer       User                 @relation("MeetingOrganizer", fields: [organizer_id], references: [id])
  project         project_list?        @relation(fields: [project_id], references: [id])
  task            task_list?           @relation(fields: [task_id], references: [id])

  @@index([meeting_code], map: "meetings_meeting_code_idx")
  @@index([organizer_id], map: "meetings_organizer_id_fkey")
  @@index([project_id], map: "meetings_project_id_fkey")
  @@index([task_id], map: "meetings_task_id_fkey")
  @@map("meetings")
}

model MeetingParticipant {
  id          Int       @id @default(autoincrement())
  meeting_id  Int
  user_id     Int?
  guest_name  String?   @db.VarChar(255)
  guest_email String?   @db.VarChar(255)
  role        String    @default("PARTICIPANT") @db.VarChar(50)
  status      String    @default("JOINED") @db.VarChar(50)
  joined_at   DateTime?
  left_at     DateTime?
  created_at  DateTime  @default(now())
  meeting     Meeting   @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([meeting_id], map: "meeting_participants_meeting_id_fkey")
  @@index([user_id], map: "meeting_participants_user_id_fkey")
  @@map("meeting_participants")
}

model FinanceProductService {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  type        String   @db.VarChar(50)
  unit        String   @db.VarChar(50)
  brand       String?  @db.VarChar(100)
  price       Float    @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("finance_products_services")
}

model FinanceContact {
  id          Int      @id @default(autoincrement())
  type        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  address     String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("finance_contacts")
}
