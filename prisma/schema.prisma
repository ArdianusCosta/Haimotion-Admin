generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                      @id @default(autoincrement())
  firstname              String                   @db.VarChar(200)
  lastname               String                   @db.VarChar(200)
  email                  String                   @db.VarChar(200)
  notification_email     String?                  @db.VarChar(255)
  password               String                   @db.Text
  type                   Int                      @default(2) @db.TinyInt
  avatar                 String                   @db.Text
  date_created           DateTime                 @default(now()) @db.DateTime(0)
  nik                    String?                  @db.VarChar(50)
  address                String?                  @db.Text
  chat_groups            ChatGroup[]
  chat_messages          ChatMessage[]
  threads_as_user1       ChatThread[]             @relation("User1Threads")
  threads_as_user2       ChatThread[]             @relation("User2Threads")
  group_members          group_members[]
  group_messages         GroupMessage[]
  user_group_read_status user_group_read_status[]
  ai_chat_history        ai_chat_history[]
  ai_chat_thread         ai_chat_thread[]

  folders                    Folder[]
  files                      File[]
  files_shared_with_me       FileShare[]   @relation("SharedWithUserFiles")
  files_shared_by_me         FileShare[]   @relation("SharedByUserFiles")
  folders_shared_with_me     FolderShare[] @relation("SharedWithUserFolders")
  folders_shared_by_me       FolderShare[] @relation("SharedByUserFolders")
  user_preference            UserPreference?

  @@map("users")
}

model ChatGroup {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @db.VarChar(255)
  description            String?                  @db.Text
  created_by             Int?
  date_created           DateTime?                @default(now()) @db.DateTime(0)
  last_message_at        DateTime?                @default(now()) @db.DateTime(0)
  users                  User?                    @relation(fields: [created_by], references: [id], onUpdate: Restrict, map: "chat_groups_ibfk_1")
  group_members          group_members[]
  messages               GroupMessage[]
  user_group_read_status user_group_read_status[]

  @@index([created_by], map: "created_by")
  @@map("chat_groups")
}

model GroupMessage {
  id              Int       @id @default(autoincrement())
  group_id        Int
  sender_id       Int
  message_content String    @db.Text
  attachment      String?   @db.VarChar(255)
  created_at      DateTime? @default(now()) @db.DateTime(0)
  group           ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_messages_ibfk_1")
  sender          User      @relation(fields: [sender_id], references: [id], onUpdate: Restrict, map: "group_messages_ibfk_2")

  @@index([group_id], map: "group_id")
  @@index([sender_id], map: "sender_id")
  @@map("group_messages")
}

model ChatThread {
  id              Int           @id @default(autoincrement())
  user1_id        Int
  user2_id        Int
  last_message_at DateTime      @default(now()) @db.DateTime(0)
  calls           Call[]
  messages        ChatMessage[]
  user1           User          @relation("User1Threads", fields: [user1_id], references: [id], onUpdate: Restrict, map: "chat_threads_ibfk_1")
  user2           User          @relation("User2Threads", fields: [user2_id], references: [id], onUpdate: Restrict, map: "chat_threads_ibfk_2")

  @@unique([user1_id, user2_id], map: "unique_thread_pair")
  @@index([user2_id], map: "user2_id")
  @@map("chat_threads")
}

model ChatMessage {
  id              Int        @id @default(autoincrement())
  thread_id       Int
  sender_id       Int
  message_content String     @db.Text
  attachment      String?    @db.VarChar(255)
  reply_to_id     Int?
  created_at      DateTime   @default(now()) @db.DateTime(0)
  is_read         Boolean    @default(false)
  thread          ChatThread @relation(fields: [thread_id], references: [id], onUpdate: Restrict, map: "chat_messages_ibfk_1")
  sender          User       @relation(fields: [sender_id], references: [id], onUpdate: Restrict, map: "chat_messages_ibfk_2")
  reply_to        ChatMessage?  @relation("MessageReplies", fields: [reply_to_id], references: [id])
  replies         ChatMessage[] @relation("MessageReplies")

  @@index([sender_id], map: "sender_id")
  @@index([thread_id], map: "thread_id")
  @@index([reply_to_id], map: "reply_to_id")
  @@map("chat_messages")
}

model Call {
  id         Int        @id @default(autoincrement())
  thread_id  Int
  caller_id  Int
  room_name  String     @unique(map: "unique_room") @db.VarChar(255)
  type       String     @db.VarChar(50)
  status     String     @db.VarChar(50)
  started_at DateTime?  @db.DateTime(0)
  ended_at   DateTime?  @db.DateTime(0)
  duration   Int?
  created_at DateTime   @default(now()) @db.DateTime(0)
  thread     ChatThread @relation(fields: [thread_id], references: [id], onUpdate: Restrict, map: "calls_ibfk_1")

  @@index([thread_id], map: "thread_id")
  @@map("calls")
}

model activity_log {
  id            Int       @id @default(autoincrement())
  user_id       Int
  project_id    Int?
  task_id       Int?
  activity_type String    @db.VarChar(50)
  description   String    @db.Text
  created_at    DateTime? @default(now()) @db.DateTime(0)
}

model events {
  id                   Int       @id @default(autoincrement())
  ical_uid             String?   @db.VarChar(255)
  google_calendar_id   String?   @db.VarChar(255)
  project_id           Int?
  title                String    @db.VarChar(255)
  start_event          DateTime  @db.DateTime(0)
  end_event            DateTime  @db.DateTime(0)
  color                String?   @default("bg-primary") @db.VarChar(50)
  description          String?   @db.Text
  notification_sent    Boolean?  @default(false)
  notification_sent_at DateTime? @db.DateTime(0)

  @@index([id], map: "id")
  @@index([google_calendar_id], map: "idx_google_calendar_id")
  @@index([ical_uid], map: "idx_ical_uid")
  @@index([project_id], map: "idx_project")
}

model group_members {
  id          Int       @id @default(autoincrement())
  group_id    Int
  user_id     Int
  is_admin    Boolean?  @default(false)
  date_joined DateTime? @default(now()) @db.DateTime(0)
  chat_groups ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_members_ibfk_1")
  users       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "group_members_ibfk_2")

  @@unique([group_id, user_id], map: "unique_member")
  @@index([user_id], map: "user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model notification_list {
  id           Int      @id @default(autoincrement())
  user_id      Int
  type         Boolean
  message      String   @db.Text
  link         String   @db.Text
  is_read      Boolean  @default(false)
  date_created DateTime @default(now()) @db.DateTime(0)
  task_id      String?  @db.VarChar(255)
}

model project_list {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  description  String   @db.Text
  status       Int      @db.TinyInt
  start_date   DateTime @db.Date
  end_date     DateTime @db.Date
  manager_id   Int
  user_ids     String   @db.Text
  date_created DateTime @default(now()) @db.DateTime(0)
  is_favorite  Boolean  @default(false)
  is_archived  Boolean  @default(false)
  client_name  String?  @db.VarChar(200)
}

model system_settings {
  id        Int    @id @default(autoincrement())
  name      String @db.Text
  email     String @db.VarChar(200)
  contact   String @db.VarChar(20)
  address   String @db.Text
  cover_img String @db.Text
}

model task_list {
  id              Int       @id @default(autoincrement())
  project_id      Int
  user_ids        String?   @db.Text
  user_id         Int?
  task            String    @db.VarChar(200)
  description     String    @db.Text
  status          Int       @db.TinyInt
  start_date      DateTime? @db.Date
  end_date        DateTime? @db.Date
  date_created    DateTime  @default(now()) @db.DateTime(0)
  created_by      Int?
  content_pillar  String?   @db.Text
  platform        String?   @db.Text
  reference_links String?   @db.Text
  date_updated    DateTime? @db.DateTime(0)
  dependencies    String?   @db.Text
}

model user_group_read_status {
  id           Int       @id @default(autoincrement())
  group_id     Int
  user_id      Int
  last_read_at DateTime  @default(now()) @db.DateTime(0)
  chat_groups  ChatGroup @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_group_read_status_ibfk_1")
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "user_group_read_status_ibfk_2")

  @@unique([group_id, user_id], map: "unique_read")
  @@index([user_id], map: "user_id")
}

model user_productivity {
  id            Int      @id @default(autoincrement())
  project_id    Int
  task_id       Int
  comment       String   @db.Text
  subject       String   @db.VarChar(200)
  date          DateTime @db.Date
  start_time    DateTime @db.Time(0)
  end_time      DateTime @db.Time(0)
  user_id       Int
  time_rendered Float    @db.Float
  date_created  DateTime @default(now()) @db.DateTime(0)
}

model task_comments {
  id         Int      @id @default(autoincrement())
  task_id    Int
  user_id    Int
  comment    String   @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)

  @@index([task_id], map: "idx_task_comments_task")
}

model task_attachments {
  id          Int      @id @default(autoincrement())
  task_id     Int
  file_url    String   @db.VarChar(500)
  file_name   String   @db.VarChar(255)
  uploaded_by Int?
  uploaded_at DateTime @default(now()) @db.DateTime(0)

  @@index([task_id], map: "idx_task_attachments_task")
}

model ai_chat_thread {
  id         String   @id @default(uuid())
  user_id    Int
  title      String   @db.VarChar(255)
  is_pinned  Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  user     User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages ai_chat_history[]

  @@index([user_id], map: "idx_user_ai_thread")
}

model ai_chat_history {
  id         Int      @id @default(autoincrement())
  thread_id  String
  user_id    Int
  role       String   @db.VarChar(50)
  content    String   @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)

  thread ai_chat_thread @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  users  User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_ai_chat")
  @@index([thread_id], map: "idx_thread_ai_chat")
}

model Folder {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(255)
  parent_id  Int?
  owner_id   Int
  created_at DateTime  @default(now()) @db.DateTime(0)
  updated_at DateTime  @default(now()) @updatedAt @db.DateTime(0)
  deleted_at DateTime? @db.DateTime(0)

  owner    User          @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  parent   Folder?       @relation("FolderHierarchy", fields: [parent_id], references: [id])
  children Folder[]      @relation("FolderHierarchy")
  files    File[]
  shares   FolderShare[]

  @@index([owner_id], map: "idx_folder_owner")
  @@index([parent_id], map: "idx_folder_parent")
}

model File {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  original_name String    @db.VarChar(255)
  storage_key   String    @db.VarChar(500)
  mime_type     String    @db.VarChar(100)
  extension     String    @db.VarChar(50)
  size          BigInt
  folder_id     Int?
  owner_id      Int
  is_starred    Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.DateTime(0)
  deleted_at    DateTime? @db.DateTime(0)

  owner  User        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  folder Folder?     @relation(fields: [folder_id], references: [id])
  shares FileShare[]

  @@index([owner_id], map: "idx_file_owner")
  @@index([folder_id], map: "idx_file_folder")
}

model FileShare {
  id                  Int      @id @default(autoincrement())
  file_id             Int
  shared_with_user_id Int
  permission          String   @db.VarChar(50) // 'viewer', 'editor', 'manager'
  shared_by_user_id   Int
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime(0)

  file             File @relation(fields: [file_id], references: [id], onDelete: Cascade)
  shared_with_user User @relation("SharedWithUserFiles", fields: [shared_with_user_id], references: [id], onDelete: Cascade)
  shared_by_user   User @relation("SharedByUserFiles", fields: [shared_by_user_id], references: [id], onDelete: Cascade)

  @@unique([file_id, shared_with_user_id], map: "uniq_fileshare")
  @@index([file_id], map: "idx_fileshare_file")
  @@index([shared_with_user_id], map: "idx_fileshare_shared_with")
}

model FolderShare {
  id                  Int      @id @default(autoincrement())
  folder_id           Int
  shared_with_user_id Int
  permission          String   @db.VarChar(50) // 'viewer', 'editor', 'manager'
  shared_by_user_id   Int
  created_at          DateTime @default(now()) @db.DateTime(0)
  updated_at          DateTime @default(now()) @updatedAt @db.DateTime(0)

  folder           Folder @relation(fields: [folder_id], references: [id], onDelete: Cascade)
  shared_with_user User   @relation("SharedWithUserFolders", fields: [shared_with_user_id], references: [id], onDelete: Cascade)
  shared_by_user   User   @relation("SharedByUserFolders", fields: [shared_by_user_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, shared_with_user_id], map: "uniq_foldershare")
  @@index([folder_id], map: "idx_foldershare_folder")
  @@index([shared_with_user_id], map: "idx_foldershare_shared_with")
}

model UserPreference {
  id                     Int      @id @default(autoincrement())
  user_id                Int      @unique
  file_manager_view_mode String   @default("grid") @db.VarChar(50) // 'grid' | 'list'
  
  // Theme and Layout Preferences
  layout_style           String   @default("sidebar") @db.VarChar(50)
  theme_color            String   @default("Green") @db.VarChar(50)
  theme_radius           String   @default("0.5") @db.VarChar(10)
  theme_mode             String   @default("system") @db.VarChar(50)
  content_width          String   @default("centered") @db.VarChar(50)
  header_style           String   @default("sticky") @db.VarChar(50)
  sidebar_style          String   @default("sidebar") @db.VarChar(50)

  created_at             DateTime @default(now()) @db.DateTime(0)
  updated_at             DateTime @default(now()) @updatedAt @db.DateTime(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
